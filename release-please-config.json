{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "phone-backup",
      "version-file": "version.txt",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/gui/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/gui/ui/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
